// ---------------------------------------------------------------------------
// auto-job-applier — Postgres schema (issue #2)
//
// See /README.md for how to run migrations locally, and the "Encryption at
// rest" section below for how sensitive columns are handled.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// No pgcrypto / DB-side crypto extension is used anywhere in this schema.
// `gen_random_uuid()` below is core Postgres (built in since PG13), not the
// pgcrypto extension, so primary-key generation needs zero extensions.
//
// This is deliberate: the encryption boundary for sensitive data sits
// entirely in the application layer (see lib/encryption.ts), not in
// Postgres. The database only ever sees opaque ciphertext bytes for the
// sensitive columns below (resumeFileUrlEncrypted, valueEncrypted) — it has
// no ability to encrypt/decrypt/inspect them, and never holds a key. See
// README "Encryption at rest" for the full rationale.

// ===========================================================================
// Enums
//
// Closed, user-facing value sets are modeled as native Postgres enums (via
// Prisma's @map) so the exact display label is stored in the database while
// the generated client exposes a friendly identifier. This gives us real
// DB-level validation for dropdown-style fields instead of relying solely on
// application code.
// ===========================================================================

/// Profile.levels — seniority levels a user is targeting.
enum ProfileLevel {
  ENTRY_LEVEL     @map("Entry level")
  MID_LEVEL       @map("Mid level")
  SENIOR          @map("Senior")
  STAFF_PRINCIPAL @map("Staff / Principal")
  MANAGER         @map("Manager")
  DIRECTOR        @map("Director")
  EXECUTIVE_VP    @map("Executive / VP")
}

/// Filters.work_arrangement
enum WorkArrangement {
  REMOTE @map("Remote")
  HYBRID @map("Hybrid")
  ONSITE @map("Onsite")
}

/// Filters.employment_type
enum EmploymentType {
  FULL_TIME  @map("Full-time")
  PART_TIME  @map("Part-time")
  CONTRACT   @map("Contract")
  INTERNSHIP @map("Internship")
}

/// Filters.company_size
enum CompanySize {
  STARTUP    @map("Startup (1-50)")
  SMALL_MID  @map("Small-mid (51-500)")
  LARGE      @map("Large (501-5,000)")
  ENTERPRISE @map("Enterprise (5,000+)")
}

/// Filters.date_posted
enum DatePosted {
  ANY_TIME   @map("Any time")
  PAST_DAY   @map("Past 24 hours")
  PAST_WEEK  @map("Past week")
  PAST_MONTH @map("Past month")
}

/// RequiredInfoAnswer.mode — whether the agent may auto-fill this field from
/// `value`, or must always stop and ask the user.
enum AnswerMode {
  AUTO   @map("auto")
  MANUAL @map("manual")
}

/// Application.status — the application lifecycle / pipeline stage.
enum ApplicationStatus {
  MATCHED          @map("matched")
  REVIEWING        @map("reviewing")
  IN_PROGRESS      @map("in_progress")
  NEEDS_INPUT      @map("needs_input")
  READY_FOR_REVIEW @map("ready_for_review")
  SUBMITTED        @map("submitted")
  SKIPPED          @map("skipped")
  FAILED           @map("failed")
}

/// ApplicationLogEntry.source — where a submitted field's value came from.
enum LogEntrySource {
  AUTO               @map("auto")
  USER_PROVIDED_LIVE @map("user-provided-live")
}

// ===========================================================================
// Tables
// ===========================================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  profile               Profile?
  filters               Filters?
  requiredInfoAnswers   RequiredInfoAnswer[]
  applications          Application[]
  applicationLogEntries ApplicationLogEntry[]
  loginTokens           LoginToken[]
  sessions              Session[]
  portalCredentials     PortalCredential[]
  revealChallenges      RevealChallenge[]
  credentialRevealLog   CredentialRevealEvent[]

  @@map("users")
}

/// A single-use magic-link token (issue #3's chosen auth strategy -- see
/// apps/web/AUTH.md for the decision and reasoning). Issued by
/// `POST /api/auth/request-login` and consumed by `GET /api/auth/verify`.
///
/// SENSITIVE, same rule as resume URLs / RequiredInfoAnswer values: only a
/// SHA-256 hash of the raw token is ever stored (`tokenHash`), never the raw
/// token itself -- see apps/web/lib/auth.ts. A leaked row is therefore
/// useless to an attacker without also holding the original emailed link.
model LoginToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_tokens")
}

/// A logged-in session, created once a LoginToken is successfully consumed.
/// The raw session cookie value is never persisted -- only its SHA-256 hash
/// (`tokenHash`), mirroring LoginToken above. `apps/web/lib/current-user.ts`
/// hashes the incoming cookie and looks it up here on every request.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One row per user. 1:1 with User — user_id is both the primary key and the
/// foreign key, so every lookup is already scoped by tenant.
///
/// SENSITIVE: `resumeFileUrlEncrypted` holds ciphertext, not a plain URL.
/// See README "Encryption at rest".
model Profile {
  userId String @id @map("user_id") @db.Uuid

  // Ciphertext (AES-256-GCM, app-level) of the S3 object reference. Never
  // store the plaintext URL in a separate column.
  resumeFileUrlEncrypted Bytes?    @map("resume_file_url_encrypted")
  resumeUploadedAt       DateTime? @map("resume_uploaded_at")
  // Not sensitive (unlike the object reference above) -- plain columns so
  // the UI can render the uploaded file's name/size without decrypting or
  // fetching the file itself. Added when wiring the Postgres-backed
  // Repository; see apps/web/lib/types.ts Profile for the domain shape.
  resumeFileName         String?   @map("resume_file_name")
  resumeFileSize         Int?      @map("resume_file_size")
  resumeMimeType         String?   @map("resume_mime_type")

  locations    String[]       @default([])
  levels       ProfileLevel[] @default([])
  targetTitles String[]       @default([]) @map("target_titles")

  // Contact fields (added so the apply agent has a real data source for the
  // most common non-required-info application fields, instead of always
  // yielding to the human for name/phone/email/links -- see
  // apps/apply-agent-service's field-matcher.ts "no data source yet" note).
  // Not sensitive in the same way RequiredInfoAnswer values are (immigration
  // status, disability, etc.), so these are plain columns, not encrypted --
  // same treatment as resumeFileName/resumeFileSize above.
  fullName      String? @map("full_name")
  phone         String?
  // Contact email for applications, distinct from the login email on User
  // (which is used for magic-link auth). Falls back to User.email in the
  // application layer when null -- see apps/web/lib/repository/mapping.ts.
  contactEmail  String? @map("contact_email")
  linkedinUrl   String? @map("linkedin_url")
  portfolioUrl  String? @map("portfolio_url")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// One row per user. 1:1 with User.
model Filters {
  userId String @id @map("user_id") @db.Uuid

  workArrangement     WorkArrangement[] @default([]) @map("work_arrangement")
  employmentType      EmploymentType[]  @default([]) @map("employment_type")
  companySize         CompanySize[]     @default([]) @map("company_size")
  salaryMin           Int?              @map("salary_min")
  datePosted          DatePosted        @default(ANY_TIME) @map("date_posted")
  industries          String[]          @default([])
  excludeCompanies    String[]          @default([]) @map("exclude_companies")
  specialInstructions String?           @map("special_instructions") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("filters")
}

/// One row per (user, field_id). Standard field_ids: work_auth, sponsorship,
/// veteran, disability, race_ethnicity, gender, security_clearance,
/// criminal_history — but field_id is intentionally free-text (not an enum)
/// so new fields can be added without a migration. criminal_history is
/// modeled like every other field at the schema level, but whether "auto"
/// mode is legally permitted for it (issue #7 — ban-the-box / fair-chance
/// hiring laws) is NOT something this table or Postgres enforces: it's a
/// row-level CHECK-free `AnswerMode` column, same as every other field.
/// Enforcement lives one layer up, in application code, because it depends
/// on the *job's* jurisdiction, which this table has no column for: see
/// packages/db/lib/policy/README.md and
/// packages/db/lib/policy/criminal-history-jurisdiction.ts, which unconditionally
/// downgrade `mode=auto` requests for criminal_history to `manual` at save
/// time (apps/web/lib/repository/postgres.ts's saveRequiredInfoAnswer) until
/// real legal sign-off exists per jurisdiction. A raw SQL write or future
/// migration script that bypasses that repository method would bypass this
/// gate too — this column alone does not stop `mode = AUTO` from being
/// written for criminal_history. apps/apply-agent-service's field-matcher
/// also calls isCriminalHistoryAutoModeAllowed(job.jurisdiction) before ever
/// treating this field as auto-fillable, as defense-in-depth on top of the
/// save-time gate.
///
/// SENSITIVE: `valueEncrypted` holds ciphertext, not plaintext. It is only
/// meaningful when mode = AUTO. See README "Encryption at rest".
model RequiredInfoAnswer {
  userId  String @map("user_id") @db.Uuid
  fieldId String @map("field_id")

  mode           AnswerMode @default(MANUAL)
  valueEncrypted Bytes?     @map("value_encrypted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
  @@map("required_info_answers")
}

/// Job postings pulled in from source connectors (job boards / ATSs).
/// Not user-scoped — a listing is a shared, tenant-agnostic fact. Classifier
/// fields (remoteType, employmentType, level, companySize) are deliberately
/// free text rather than the enums used on Filters/Profile: connector data is
/// heterogeneous and not guaranteed to match our closed vocabularies at
/// ingestion time, and forcing an enum here would make ingestion brittle.
/// rawPayload retains the untouched connector response for debugging /
/// re-normalization when the mapping is wrong or the vocabulary drifts.
model JobListing {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceConnector String @map("source_connector")
  externalId      String @map("external_id")

  title          String
  company        String
  location       String?
  remoteType     String?   @map("remote_type")
  employmentType String?   @map("employment_type")
  level          String?
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  companySize    String?   @map("company_size")
  industry       String?
  datePosted     DateTime? @map("date_posted")
  url            String

  rawPayload Json @map("raw_payload")

  applications Application[]

  @@unique([sourceConnector, externalId], name: "sourceConnector_externalId")
  @@index([sourceConnector])
  @@index([datePosted])
  @@map("job_listings")
}

/// A user's pursuit of a specific JobListing.
model Application {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  jobListingId String            @map("job_listing_id") @db.Uuid
  status       ApplicationStatus @default(MATCHED)
  createdAt    DateTime          @default(now()) @map("created_at")
  submittedAt  DateTime?         @map("submitted_at")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListing JobListing            @relation(fields: [jobListingId], references: [id], onDelete: Restrict)
  logEntries ApplicationLogEntry[]

  // A user should have at most one Application per JobListing.
  @@unique([userId, jobListingId])
  @@index([userId])
  @@index([jobListingId])
  @@index([status])
  @@map("applications")
}

/// Audit trail of what was submitted on a user's behalf during form-filling.
///
/// PRIVACY-CRITICAL: this table records `valueCategory` (a coarse label,
/// e.g. "work_authorization", "veteran_status") and never the raw value that
/// was typed/selected. There is intentionally NO column capable of holding a
/// raw field value — do not add one. The soft length check below is defense
/// in depth (raw free-text answers are unlikely to fit in a short category
/// label) — not a substitute for callers doing the right thing.
model ApplicationLogEntry {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  timestamp     DateTime       @default(now())
  fieldLabel    String         @map("field_label")
  valueCategory String         @map("value_category")
  sentTo        String         @map("sent_to")
  source        LogEntrySource

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@map("application_log_entries")
}

// ===========================================================================
// Portal credentials (ATS account vault)
//
// The apply agent sometimes cannot proceed without an account on the
// employer's ATS (Workday and iCIMS in particular gate the application form
// behind registration). These tables are where those account credentials
// live.
//
// SENSITIVE, and handled the same way as every other sensitive column in
// this schema: `passwordEncrypted` is `Bytes` holding AES-256-GCM ciphertext
// produced by lib/encryption.ts. Postgres never sees the plaintext and never
// holds a key. See packages/db/CREDENTIALS.md for the full design.
//
// Note the deliberate asymmetry with LoginToken/Session above: those store a
// SHA-256 *hash* because nothing ever needs the original value back -- they
// only ever need to answer "does this incoming token match?". Portal
// passwords are the opposite: the agent must reproduce the exact plaintext
// to type into a login form, and the user must be able to read it to sign in
// manually. That forces reversible encryption rather than hashing, which is
// strictly weaker, and is why the key-management and reveal-audit machinery
// around these two tables is heavier than anything guarding the token tables.
// ===========================================================================

/// One saved account on one ATS domain.
///
/// `domain` is the *registrable* domain (eTLD+1, e.g. "myworkdayjobs.com"),
/// normalized and allowlist-checked by lib/policy/account-creation-allowlist.ts
/// before any row is ever written. Storing the registrable domain rather than
/// the full hostname is what makes one saved credential reusable across the
/// per-tenant subdomains those ATSs hand out (acme.myworkdayjobs.com,
/// globex.myworkdayjobs.com, ...), which is how these accounts actually work.
model PortalCredential {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Registrable domain (eTLD+1), lowercased. See allowlist module.
  domain String
  /// Human-facing label for the UI, e.g. "Workday". Never used for matching.
  siteName String @map("site_name")
  /// The hostname the account was actually created on, kept for the audit
  /// trail. Matching uses `domain`; this records where it came from.
  originHostname String @map("origin_hostname")

  /// Not encrypted: usernames are almost always the user's own email, which
  /// is already stored in plaintext on `users.email`. Encrypting it here
  /// would imply a confidentiality guarantee the rest of the schema doesn't
  /// make, at the cost of making the list view undecryptable-by-design.
  username String

  /// Ciphertext (AES-256-GCM, app-level) of the account password. There is
  /// intentionally NO plaintext password column -- do not add one.
  passwordEncrypted Bytes @map("password_encrypted")

  /// True when the agent generated this account itself, false when the user
  /// saved credentials for an account they already had. Surfaced in the UI
  /// because "did a robot make this?" is a question users reasonably ask.
  createdByAgent Boolean @default(true) @map("created_by_agent")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastRevealedAt DateTime? @map("last_revealed_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  revealLog  CredentialRevealEvent[]

  // One account per (user, domain, username). A user may legitimately hold
  // two accounts on the same ATS under different emails, so username is part
  // of the key rather than (user, domain) alone.
  @@unique([userId, domain, username])
  @@index([userId])
  @@map("portal_credentials")
}

/// A short-lived, single-use code proving the human is still present before
/// any password is decrypted and returned.
///
/// This exists because the app's primary auth is a 30-day magic-link session
/// cookie (see apps/web/AUTH.md). A 30-day cookie is a reasonable bar for
/// "show me my job feed" and a poor one for "show me every password I own":
/// an unattended laptop is enough. There is no account password to re-prompt
/// for under magic-link auth, so re-authentication here means re-proving
/// control of the email address -- a fresh code, emailed, good for 10
/// minutes, unlocking a 5-minute reveal window.
///
/// SENSITIVE, hashed not encrypted -- same reasoning as LoginToken: nothing
/// ever needs the original code back, only "does this match?".
model RevealChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set when the code is redeemed. A redeemed challenge unlocks reveals
  /// until `unlockedUntil`; it can never be redeemed a second time.
  consumedAt    DateTime? @map("consumed_at")
  unlockedUntil DateTime? @map("unlocked_until")
  /// Incremented on each failed redeem attempt; the challenge is dead once
  /// this hits MAX_REVEAL_CHALLENGE_ATTEMPTS, so a 6-digit code can't be
  /// brute-forced within its 10-minute life.
  failedAttempts Int      @default(0) @map("failed_attempts")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reveal_challenges")
}

/// Append-only audit trail: one row per password decryption.
///
/// Unlike ApplicationLogEntry (which is deliberately incapable of holding a
/// raw value), this table records only *that* a reveal happened and from
/// where -- never the password, and never anything derived from it. Its
/// purpose is to make silent credential exfiltration impossible: if
/// something reads the vault, there is a row for it.
model CredentialRevealEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  timestamp    DateTime @default(now())
  /// "ui" (user clicked Reveal) or "agent" (apply-agent used it to log in).
  revealedBy   String   @map("revealed_by")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  credential PortalCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("credential_reveal_events")
}
