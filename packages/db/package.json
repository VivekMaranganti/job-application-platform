{
  "name": "auto-job-applier-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema/migrations for the auto-job-applier data model (issue #2). Prisma is scoped to the database layer here; the Next.js app scaffold (issue #1) imports this schema/client as the Postgres-backed Repository implementation.",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:seed:greenhouse": "node connectors/greenhouse/run.ts",
    "db:seed:lever": "node connectors/lever/run.ts",
    "db:seed:ashby": "node connectors/ashby/run.ts",
    "db:seed:smartrecruiters": "node connectors/smartrecruiters/run.ts",
    "db:seed:all": "npm run db:seed:greenhouse; npm run db:seed:lever; npm run db:seed:ashby; npm run db:seed:smartrecruiters",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types",
    "test:smoke": "tsx --env-file=.env scripts/smoke-test-vault.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0"
  }
}
