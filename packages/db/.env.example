# Copy to .env (git-ignored) and fill in real values for local development.

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_job_applier?schema=public"

# Dev/test-only symmetric key for lib/encryption.ts (AES-256-GCM), base64
# encoded, must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# NOT for production use -- see README "Encryption at rest" for why.
FIELD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Absolute path to a directory on this machine where uploaded resumes are
# stored (lib/resume-storage.ts's LocalDiskResumeStorage). Required -- there
# is no default. Must be the exact same value in packages/db/.env and
# apps/web/.env.local (both processes read/write the same files). Typically
# `<repo path>/packages/db/.data/resumes`, e.g.:
#   RESUME_STORAGE_DIR="/Users/you/Documents/job_scraper/packages/db/.data/resumes"
RESUME_STORAGE_DIR="REPLACE_WITH_ABSOLUTE_PATH"
