{
  "name": "auto-job-applier",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo root. apps/web is the Next.js app (issue #1); packages/db is the Postgres/Prisma schema package (issue #2, built on branch agent/postgres-schema and merged in here).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "db:seed:greenhouse": "npm run db:seed:greenhouse --workspace=auto-job-applier-db",
    "db:seed:lever": "npm run db:seed:lever --workspace=auto-job-applier-db"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "fsevents@2.3.3": true
  }
}
