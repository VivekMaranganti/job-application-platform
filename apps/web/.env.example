# Copy to .env.local (git-ignored) and fill in real values for local
# development. Next.js only loads env files from this app's own directory
# (apps/web), not from the monorepo root or packages/db -- even though the
# variables below are consumed by packages/db's code (lib/client.ts,
# lib/encryption.ts) once apps/web imports it. See packages/db/README.md
# for the fuller explanation of each variable.

# Same Postgres instance/database as packages/db/.env -- see that file and
# README.md "Running migrations locally" for how to set the database up.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_job_applier?schema=public"

# Must be the exact same value as packages/db/.env's FIELD_ENCRYPTION_KEY --
# both processes decrypt the same columns, so a mismatch means apps/web
# can't read what packages/db (migrations/seeding) wrote, or vice versa.
FIELD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Optional. Powers the Profile tab's "derive target titles from my resume"
# feature (lib/title-derivation.ts) via the Anthropic API. Leave unset to
# skip that one feature -- everything else works without it.
ANTHROPIC_API_KEY=""
