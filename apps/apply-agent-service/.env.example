# Shared with packages/db / apps/web -- see packages/db/README.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_job_applier?schema=public"
FIELD_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Which LLM powers in-session field-filling decisions -- see README.md
# "Open decision 2". Required for anything beyond the deterministic
# keyword-based field classification in agent/field-matcher.ts.
ANTHROPIC_API_KEY=""

# This service's own config -- see src/config.ts.
APPLY_AGENT_SERVICE_PORT=4100
APPLY_AGENT_MIN_CONFIDENCE=0.75
APPLY_AGENT_MODEL="claude-opus-4-8"
APPLY_AGENT_BROWSER_PROVIDER="self-hosted"
APPLY_AGENT_HEADLESS="true"
