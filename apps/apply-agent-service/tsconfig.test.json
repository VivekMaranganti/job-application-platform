{
  // Typechecks the test files, which tsconfig.json excludes. Separate config
  // because tests import with explicit ".ts" specifiers (see that file's
  // note) and `allowImportingTsExtensions` requires `noEmit`, while the build
  // config emits to dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
